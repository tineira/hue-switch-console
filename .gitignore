# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local topology snapshots (use Vercel KV in production)
/data

# vercel
.vercel

# Agent / browser tooling (local only)
.grok/
.playwright-mcp/

# Scratch working notes (delete after use; never commit)
docs/_audit-*.md
docs/_review-*.md

# typescript
*.tsbuildinfo
next-env.d.ts
