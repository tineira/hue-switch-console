# Neon (Vercel Marketplace). Pooled URL for serverless.
DATABASE_URL=postgresql://...
# Any other Postgres: set DATABASE_DRIVER=pg
# DATABASE_DRIVER=pg

# Signs session cookies (Better Auth). Generate with: openssl rand -base64 32
AUTH_SECRET=

# First console user (seeded, password sign-in). Keep real values in .env.local only.
# Also the admin unless ADMIN_EMAILS is set.
USER_EMAIL=you@example.com
USER_PASSWORD=change-me-too

# Hosted console only; each is optional. See README "Accounts and sign-in".
# RESEND_API_KEY=
# EMAIL_FROM=Hue Switch <codes@example.com>
# SIGNUP_MODE=closed   (closed, invite, waitlist or open)
# USER_CAP=
# WAITLIST_EMAILS_PER_DAY=40
# RESEND_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# BETTER_AUTH_URL=https://hue.example.com
# ADMIN_EMAILS=
# CRON_SECRET=
# EMAIL_DEV_CONSOLE=1   (local dev: print codes instead of sending)
# EMAIL_DAILY_CAP=90   (emails a day; Resend's free tier is 100)
# CONTACT_EMAIL=       (shown on /privacy)
# PRIVACY_URL=         (replaces the /privacy link under the sign-in form)
# TERMS_URL=           (adds a Terms link)

# Per-account limits (defaults shown); /admin overrides one account.
# LIMIT_SWITCHES=25
# LIMIT_BRIDGES=5
# LIMIT_KEYS=25
# LIMIT_SNAPSHOT_KB=512

# Firmware CI uploads releases with this bearer (README "Firmware release pipeline").
# FIRMWARE_UPLOAD_TOKEN=

# Used by `npm run push-from-bridge` (run on the LAN, not on Vercel)
# HUE_BRIDGE_IP=192.168.100.12
# HUE_APP_KEY=
# CONSOLE_TOKEN=
# CONSOLE_URL=http://localhost:3000
# Production host (Cloudflare → Vercel): https://hue.tineira.com
