# Neon (Vercel Marketplace). Pooled URL for serverless.
DATABASE_URL=postgresql://...

# Signs the login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# First console user (seeded; no public signup). Keep real values in .env.local only.
USER_EMAIL=you@example.com
USER_PASSWORD=change-me-too

# Used by `npm run push-from-bridge` (run on the LAN, not on Vercel)
# HUE_BRIDGE_IP=192.168.100.12
# HUE_APP_KEY=
# CONSOLE_TOKEN=
# CONSOLE_URL=http://localhost:3000
# Production host (Cloudflare → Vercel): https://hue.tineira.com
