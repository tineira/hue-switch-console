# Shared secret for POST/GET /api/ingest
INGEST_TOKEN=change-me

# Optional: Upstash/Vercel KV. Without this, snapshots go to data/topology.json (local only).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Used by `npm run push-from-bridge` (run on the LAN, not on Vercel)
# HUE_BRIDGE_IP=192.168.100.12
# HUE_APP_KEY=
# CONSOLE_URL=http://localhost:3000
